{
  "name": "snapgrep",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/src/packaged-extension.js",
  "exports": {
    ".": "./dist/src/packaged-extension.js",
    "./dsh": "./dist/src/dsh-plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/src/packaged-extension.js"
    ]
  },
  "description": "An in-process trigram index that makes code search in Pi and DeepSeek Harness 20-90x faster than ripgrep, with identical results.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:kernel": "node scripts/build-kernel.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:kernel": "npm run build:kernel && PI_FAST_GREP_NATIVE_TEST=1 vitest run tests/kernel-binding-native.test.ts tests/kernel-engine-native.test.ts tests/extension-kernel-native.test.ts",
    "test:watch": "vitest",
    "fast-grep": "tsx src/cli.ts",
    "benchmark": "node --max-old-space-size=2048 --import tsx benchmarks/run.ts",
    "benchmark:generate-tail": "tsx scripts/generate-tail-corpus.ts",
    "benchmark:generate-queries": "tsx benchmarks/generate-queries.ts",
    "benchmark:prepare-typical": "tsx scripts/prepare-typical-corpus.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@napi-rs/cli": "3.7.4",
    "@types/node": "24.12.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "napi": {
    "binaryName": "pi-fast-grep-kernel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owen718/snapgrep.git"
  },
  "homepage": "https://github.com/Owen718/snapgrep#readme",
  "bugs": {
    "url": "https://github.com/Owen718/snapgrep/issues"
  },
  "keywords": [
    "grep",
    "ripgrep",
    "code-search",
    "trigram",
    "index",
    "pi",
    "pi-coding-agent",
    "dsh",
    "deepseek-harness",
    "oh-my-pi",
    "coding-agent",
    "napi-rs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "optionalDependencies": {
    "snapgrep-darwin-arm64": "0.1.1",
    "snapgrep-darwin-x64": "0.1.1",
    "snapgrep-linux-x64-gnu": "0.1.1",
    "snapgrep-linux-arm64-gnu": "0.1.1",
    "snapgrep-windows-x64": "0.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.81.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1",
    "@ff-labs/fff-node": ">=0.10.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@ff-labs/fff-node": {
      "optional": true
    }
  }
}
