{
  "name": "pi-fast-grep-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/packaged-extension.js",
  "exports": {
    ".": "./src/packaged-extension.js",
    "./dsh": "./src/dsh-plugin.js"
  },
  "files": [
    "src/*.js",
    "native/*.node",
    ".gitignore",
    "cordis.patch.yml",
    "安装说明.md"
  ],
  "pi": {
    "extensions": [
      "./src/packaged-extension.js"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
